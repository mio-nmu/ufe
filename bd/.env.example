NODE_ENV=development
PORT=4010
LOG_LEVEL=info

# MongoDB Atlas (or any replica-set MongoDB — Prisma transactions need one).
DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ufeedu_dev

JWT_ACCESS_SECRET=dev-only-change-me-access-secret-0123456789abcdef
JWT_REFRESH_SECRET=dev-only-change-me-refresh-secret-0123456789abcdef
ADMIN_PIN_CODE=1234
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_COST=12

COOKIE_DOMAIN=

CORS_ORIGIN=http://localhost:3000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
SCORER_RATE_LIMIT_MAX=3000
LIVE_READ_RATE_LIMIT_MAX=6000
AUTH_RATE_LIMIT_MAX=20
PIN_RATE_LIMIT_MAX=5

STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ufeedu
MAX_UPLOAD_MB=20

STAFF_PASSWORD=9876

# Hosted real-time push for live scores (Supabase Realtime). Project URL and
# the SECRET key (Project Settings → API Keys). Run
# supabase/live-game-realtime.sql once in the SQL editor.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
